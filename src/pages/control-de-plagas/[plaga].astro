---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import LlamadoFinal from '../../components/ui/LlamadoFinal.astro';
import TarjetaPlaga from '../../components/ui/TarjetaPlaga.astro';
import { categorias, plagas, type Plaga } from '../../data/plagas';
import { fotoDe } from '../../data/fotos';
import { sitio, sucursales, pasosTrabajo, enlace } from '../../data/sitio';

export function getStaticPaths() {
  return plagas.map((plaga) => ({ params: { plaga: plaga.slug }, props: { plaga } }));
}

const { plaga } = Astro.props as { plaga: Plaga };
const foto = fotoDe(plaga.foto);
const nombre = plaga.nombre.toLowerCase();
// Primera oración como entradilla; el resto como cuerpo
const [entradilla, ...cuerpo] = plaga.descripcion.split(/(?<=\.)\s+/);
const relacionadas = [...plagas.filter((p) => p.categoria === plaga.categoria && p.slug !== plaga.slug), ...plagas.filter((p) => p.categoria !== plaga.categoria)].slice(0, 4);
const bloques = [
  { titulo: 'Señales de alerta', lista: plaga.senales, icono: 'ph:magnifying-glass', marca: 'ph:eye-fill' },
  { titulo: 'Por qué atenderlo', lista: plaga.riesgos, icono: 'ph:warning-octagon', marca: 'ph:warning-fill' },
  { titulo: 'Cómo lo controlamos', lista: plaga.metodos, icono: 'ph:shield-check', marca: 'ph:check-circle-fill', inverso: true },
];
const datos = [
  { icono: 'ph:clock-countdown', titulo: 'Servicio 24/7', texto: 'Atención los 365 días del año' },
  { icono: 'ph:seal-check', titulo: 'Registro Cofepris', texto: 'Productos de uso urbano' },
  { icono: 'ph:user-check', titulo: 'Técnicos certificados', texto: 'Asignados a tu proyecto' },
  { icono: 'ph:map-trifold', titulo: 'Cobertura nacional', texto: 'Guadalajara, Ensenada y todo México' },
];
const whatsapp = `https://wa.me/${sucursales[0].whatsapp}?text=${encodeURIComponent(`Hola, me interesa el servicio de control de ${nombre}.`)}`;
const esquema = {
  '@type': 'Service',
  name: `Control de ${nombre}`,
  serviceType: 'Control de plagas',
  description: plaga.resumen,
  provider: { '@type': 'Organization', name: sitio.nombre, url: sitio.url },
  areaServed: 'MX',
};
---

<Base titulo={`Control de ${nombre} en Guadalajara y Ensenada`} descripcion={`${plaga.resumen} Servicio profesional de Kassar Control Total con técnicos certificados y atención 24/7.`} esquema={esquema}>
  <!-- Portada con la foto de fondo -->
  <section class="relative isolate overflow-hidden bg-tinta pt-36 pb-16 text-white lg:pt-48 lg:pb-24">
    {
      foto && (
        <div class="absolute inset-x-0 -top-[12%] -z-10 h-[124%]" data-parallax="8">
          <Image src={foto} alt="" widths={[800, 1200, 1400]} quality={60} sizes="100vw" loading="eager" class="portada-foto size-full object-cover" />
        </div>
      )
    }
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,var(--color-tinta)_8%,rgb(11_14_19/0.78)_46%,rgb(11_14_19/0.25)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-t from-tinta to-transparent"></div>

    <div class="contenedor">
      <nav aria-label="Ruta" class="flex items-center gap-2 text-xs text-white/60">
        <a href={enlace('/control-de-plagas/')} class="hover:text-oro">Control de plagas</a>
        <Icon name="ph:caret-right" class="size-3" />
        <span class="text-white/90">{plaga.nombre}</span>
      </nav>
      <p class="kicker mt-6 text-oro">{categorias[plaga.categoria]}</p>
      <h1 class="mt-4 max-w-3xl text-5xl sm:text-6xl lg:text-8xl">Control de <span class="text-oro">{nombre}</span></h1>
      <p class="mt-6 max-w-xl text-lg text-white/80 lg:text-xl">{plaga.resumen}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={enlace(`/contacto/?servicio=${encodeURIComponent(plaga.nombre)}`)} class="btn btn-oro">Cotizar este servicio</a>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-wa"><Icon name="simple-icons:whatsapp" class="size-5" /> Escribir por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Franja de garantías -->
  <section class="border-y border-linea bg-grafito text-white" aria-label="Garantías del servicio">
    <ul class="contenedor grid grid-cols-2 gap-x-6 gap-y-5 py-6 lg:grid-cols-4">
      {
        datos.map((d) => (
          <li class="flex items-center gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-oro/15 text-oro"><Icon name={d.icono} class="size-5" /></span>
            <span class="text-sm"><strong class="block font-display text-white">{d.titulo}</strong><span class="text-niebla">{d.texto}</span></span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Lo que debes saber -->
  <section class="seccion bg-papel">
    <div class="contenedor grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
      <div data-aparece>
        <p class="kicker text-oro-oscuro">Lo que debes saber</p>
        <p class="mt-4 font-display text-3xl leading-tight font-bold lg:text-[2.6rem]">{entradilla}</p>
        {cuerpo.length > 0 && <p class="mt-6 text-lg text-tinta/70">{cuerpo.join(' ')}</p>}
        {
          plaga.especies && (
            <div class="mt-8">
              <p class="kicker text-tinta/55">Especies que atendemos</p>
              <ul class="mt-3 flex flex-wrap gap-2.5">
                {
                  plaga.especies.map((e) => (
                    <li class="inline-flex items-center gap-2 rounded-full border border-tinta/15 bg-white px-4 py-2 text-sm font-medium shadow-sm">
                      <span class="size-2 rounded-full bg-oro"></span>{e}
                    </li>
                  ))
                }
              </ul>
            </div>
          )
        }
      </div>

      <div class="relative" data-aparece>
        <!-- Bloque dorado desplazado detrás de la foto -->
        <div class="absolute -right-3 -bottom-3 size-full rounded-sm border-2 border-oro lg:-right-5 lg:-bottom-5" aria-hidden="true"></div>
        <figure class="relative overflow-hidden rounded-sm bg-tinta shadow-[0_30px_60px_-30px_rgb(11_14_19/0.6)]">
          {
            foto ? (
              <Image src={foto} alt={plaga.fotoAlt ?? ''} widths={[480, 800, 1100]} quality={64} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            ) : (
              <div class="flex aspect-[4/3] items-center justify-center bg-tinta">
                <Icon name={plaga.icono} class="size-32 text-oro" />
              </div>
            )
          }
          <span class="pointer-events-none absolute inset-3 border border-white/25" aria-hidden="true"></span>
          <span class="pointer-events-none absolute top-3 left-3 size-5 border-t-[3px] border-l-[3px] border-oro" aria-hidden="true"></span>
          <span class="pointer-events-none absolute right-3 bottom-3 size-5 border-r-[3px] border-b-[3px] border-oro" aria-hidden="true"></span>
          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-linear-to-t from-tinta via-tinta/70 to-transparent p-6 pt-16 text-white">
            <span class="max-w-[16rem] text-sm text-white/85">{plaga.fotoAlt}</span>
            <span class="kicker shrink-0 rounded-full bg-oro px-3 py-1.5 text-[0.65rem] text-tinta">{plaga.nombre}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Señales, riesgos y control -->
  <section class="bg-hueso pb-20 lg:pb-28">
    <div class="contenedor pt-20 lg:pt-28">
      <div data-aparece>
        <p class="kicker text-oro-oscuro">Guía rápida</p>
        <h2 class="titulo mt-3 max-w-3xl">Cómo detectarlo, por qué importa y qué hacemos.</h2>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3 lg:gap-6">
        {
          bloques.map((b, i) => (
            <div class:list={['panel !p-7 lg:!p-8', b.inverso && 'panel-inverso']} data-aparece>
              <span class="panel-numero !text-6xl" aria-hidden="true">0{i + 1}</span>
              <span class="panel-icono"><Icon name={b.icono} class="size-6" /></span>
              <h3 class="mt-5 text-2xl">{b.titulo}</h3>
              <ul class:list={['mt-5 space-y-3 text-[0.95rem]', b.inverso ? 'text-white/80' : 'text-tinta/75']}>
                {b.lista.map((item) => <li class="flex gap-3"><Icon name={b.marca} class="mt-0.5 size-5 shrink-0 text-oro" />{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="seccion bg-tinta text-white">
    <div class="contenedor">
      <div data-aparece>
        <p class="kicker text-oro">Así trabajamos</p>
        <h2 class="titulo mt-3 max-w-3xl">Un método claro, de la inspección al seguimiento.</h2>
      </div>
      <ol class="proceso mt-14 grid gap-10 lg:grid-cols-4 lg:gap-6">
        {
          pasosTrabajo.map((p, i) => (
            <li class="relative flex gap-5 lg:block lg:pr-4" data-aparece>
              <span class="relative z-10 grid size-14 shrink-0 place-items-center rounded-full border-2 border-oro bg-tinta font-display text-lg font-bold text-oro">{i + 1}</span>
              <div class="lg:mt-5">
                <h3 class="text-xl">{p.titulo}</h3>
                <p class="mt-2 text-sm text-niebla">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- También atendemos: mini galería -->
  <section class="seccion bg-papel">
    <div class="contenedor">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end" data-aparece>
        <div>
          <p class="kicker text-oro-oscuro">Más servicios</p>
          <h2 class="titulo mt-3">También atendemos</h2>
        </div>
        <a href={enlace('/control-de-plagas/')} class="btn btn-tinta self-start sm:self-auto">Ver todos los servicios <Icon name="ph:arrow-right" class="size-4" /></a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
        {
          relacionadas.map((r) => (
            <li class="aspect-square" data-aparece>
              <TarjetaPlaga plaga={r} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <LlamadoFinal titulo={`¿Sospechas que tienes ${nombre}? Hablemos.`} />
</Base>

<style>
  /* Foto de portada: apagada para que el texto se lea y con un toque cálido */
  .portada-foto {
    filter: grayscale(0.55) brightness(0.62) contrast(1.08);
  }
  /* Línea que une los pasos (solo escritorio) */
  @media (min-width: 1024px) {
    .proceso li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.7rem;
      left: 4.2rem;
      right: 0.4rem;
      height: 2px;
      background: repeating-linear-gradient(90deg, var(--color-oro) 0 10px, transparent 10px 18px);
      opacity: 0.55;
    }
  }
  @media (max-width: 1023px) {
    .proceso li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 3.9rem;
      bottom: -2.4rem;
      left: calc(1.75rem - 1px);
      width: 2px;
      background: repeating-linear-gradient(180deg, var(--color-oro) 0 10px, transparent 10px 18px);
      opacity: 0.4;
    }
  }
</style>
