---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { categorias, plagas, type Plaga } from '../../data/plagas';
import { fotoDe } from '../../data/fotos';
import { enlace } from '../../data/sitio';

interface Props {
  plaga: Plaga;
  tam?: 'std' | 'wide' | 'tall' | 'xl';
  sizes?: string;
}
const { plaga, tam = 'std', sizes = '(min-width: 1024px) 25vw, 50vw' } = Astro.props;
const foto = fotoDe(plaga.foto);
const numero = String(plagas.findIndex((x) => x.slug === plaga.slug) + 1).padStart(2, '0');
const anchos = tam === 'xl' || tam === 'wide' ? [480, 800, 1100] : [320, 480, 640];
---

<a href={enlace(`/control-de-plagas/${plaga.slug}/`)} data-tam={tam} class="tarjeta-plaga group relative block size-full overflow-hidden rounded-sm bg-tinta text-white" aria-label={`${plaga.nombre}: ${plaga.resumen}`}>
  {
    foto ? (
      <Image src={foto} alt="" widths={anchos} quality={62} sizes={sizes} class="foto-plaga absolute inset-0 size-full object-cover" />
    ) : (
      <Icon name={plaga.icono} class="absolute top-1/2 left-1/2 size-24 -translate-x-1/2 -translate-y-1/2 text-linea" />
    )
  }
  <span class="velo absolute inset-0" aria-hidden="true"></span>
  <span class="foco absolute inset-0" aria-hidden="true"></span>

  <span class="marco" aria-hidden="true">
    <i class="esq esq-1"></i><i class="esq esq-2"></i><i class="esq esq-3"></i><i class="esq esq-4"></i>
  </span>

  <span class="numero" aria-hidden="true">{numero}</span>
  <span class="flecha" aria-hidden="true"><Icon name="ph:arrow-up-right-bold" class="size-4" /></span>

  <span class="texto absolute inset-x-0 bottom-0">
    <span class="etiqueta">{categorias[plaga.categoria]}</span>
    <span class="nombre">{plaga.nombre}</span>
    <span class="barra" aria-hidden="true"></span>
    <span class="extra">
      <span class="resumen">{plaga.resumen}</span>
      {
        tam === 'xl' && plaga.especies && (
          <span class="chips">
            {plaga.especies.slice(0, 3).map((e) => <span>{e}</span>)}
          </span>
        )
      }
      <span class="cta">Ver servicio <Icon name="ph:arrow-right-bold" class="size-3.5" /></span>
    </span>
  </span>
</a>

<style>
  /* Tarjeta con marco: reposo, hover/foco y "activa" (pantallas táctiles, al cruzar el centro) */
  .tarjeta-plaga {
    isolation: isolate;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-tinta) 40%, transparent);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease;
  }
  .tarjeta-plaga:hover,
  .tarjeta-plaga:focus-visible,
  .tarjeta-plaga.activa {
    box-shadow:
      0 0 0 1px var(--color-oro),
      0 22px 44px -20px rgb(0 0 0 / 0.6);
  }
  .tarjeta-plaga:active {
    transform: scale(0.97);
  }

  .velo {
    background:
      linear-gradient(to top, var(--color-tinta) 4%, color-mix(in srgb, var(--color-tinta) 55%, transparent) 38%, transparent 70%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-tinta) 55%, transparent), transparent 28%);
  }
  /* Foco de luz dorado que sigue al cursor */
  .foco {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(245 184 31 / 0.28), transparent 65%);
    mix-blend-mode: screen;
    transition: opacity 0.35s ease;
  }
  @media (hover: hover) {
    .tarjeta-plaga:hover .foco {
      opacity: 1;
    }
  }

  .marco {
    position: absolute;
    inset: 10px;
    z-index: 1;
    pointer-events: none;
    border: 1px solid rgb(255 255 255 / 0.18);
    transition:
      inset 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.35s ease;
  }
  .tarjeta-plaga:hover .marco,
  .tarjeta-plaga:focus-visible .marco,
  .tarjeta-plaga.activa .marco {
    inset: 14px;
    border-color: color-mix(in srgb, var(--color-oro) 55%, transparent);
  }
  .esq {
    position: absolute;
    width: 16px;
    height: 16px;
    opacity: 0;
    border: 0 solid var(--color-oro);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .esq-1 { top: -2px; left: -2px; border-top-width: 3px; border-left-width: 3px; transform: translate(6px, 6px); }
  .esq-2 { top: -2px; right: -2px; border-top-width: 3px; border-right-width: 3px; transform: translate(-6px, 6px); }
  .esq-3 { bottom: -2px; left: -2px; border-bottom-width: 3px; border-left-width: 3px; transform: translate(6px, -6px); }
  .esq-4 { bottom: -2px; right: -2px; border-bottom-width: 3px; border-right-width: 3px; transform: translate(-6px, -6px); }
  .tarjeta-plaga:hover .esq,
  .tarjeta-plaga:focus-visible .esq,
  .tarjeta-plaga.activa .esq {
    opacity: 1;
    transform: none;
  }

  .numero {
    position: absolute;
    top: 1.3rem;
    left: 1.4rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-oro);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }
  .flecha {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: var(--color-oro);
    color: var(--color-tinta);
    opacity: 0;
    transform: scale(0.5) rotate(-45deg);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }
  .tarjeta-plaga:hover .flecha,
  .tarjeta-plaga:focus-visible .flecha,
  .tarjeta-plaga.activa .flecha {
    opacity: 1;
    transform: none;
  }

  .texto {
    z-index: 2;
    display: block;
    padding: 1rem;
  }
  .etiqueta {
    display: block;
    font-family: var(--font-display);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--color-oro);
  }
  .nombre {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.1;
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.55);
  }
  .barra {
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 0.6rem;
    background: var(--color-oro);
    transform-origin: left;
    transform: scaleX(0.3);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tarjeta-plaga:hover .barra,
  .tarjeta-plaga:focus-visible .barra,
  .tarjeta-plaga.activa .barra {
    transform: scaleX(1.6);
  }

  /* Detalle que se despliega: solo desde 640 px; en móvil la tarjeta se queda limpia */
  .extra {
    display: none;
  }
  .resumen {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.88);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }
  .chips span {
    padding: 0.2rem 0.55rem;
    font-size: 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 9999px;
    background: rgb(11 14 19 / 0.45);
    backdrop-filter: blur(4px);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-oro);
  }
  .cta :global(svg) {
    transition: transform 0.3s ease;
  }
  .tarjeta-plaga:hover .cta :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 640px) {
    .etiqueta {
      font-size: 0.625rem;
      letter-spacing: 0.2em;
    }
    .extra {
      display: block;
      max-height: 0;
      margin-top: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        max-height 0.5s ease,
        opacity 0.35s ease,
        margin 0.5s ease;
    }
    .tarjeta-plaga:hover .extra,
    .tarjeta-plaga:focus-visible .extra,
    .tarjeta-plaga.activa .extra,
    .tarjeta-plaga[data-tam='xl'] .extra {
      max-height: 10rem;
      margin-top: 0.55rem;
      opacity: 1;
    }
  }
  @media (min-width: 1024px) {
    .texto {
      padding: 1.25rem;
    }
    .nombre {
      font-size: 1.375rem;
    }
    .tarjeta-plaga[data-tam='wide'] .nombre,
    .tarjeta-plaga[data-tam='tall'] .nombre {
      font-size: 1.75rem;
    }
    .tarjeta-plaga[data-tam='xl'] .texto {
      padding: 2rem;
    }
    .tarjeta-plaga[data-tam='xl'] .nombre {
      font-size: 2.75rem;
    }
    .tarjeta-plaga[data-tam='xl'] .resumen {
      max-width: 26rem;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marco,
    .esq,
    .flecha,
    .barra,
    .extra,
    .foco,
    .tarjeta-plaga {
      transition: none;
    }
  }
</style>

<script>
  // Pantallas táctiles: no hay hover, así que las tarjetas que cruzan el centro de la pantalla toman color
  if (matchMedia('(hover: none)').matches) {
    const observador = new IntersectionObserver(
      (entradas) => entradas.forEach((e) => e.target.classList.toggle('activa', e.isIntersecting)),
      { rootMargin: '-30% 0px -30% 0px' },
    );
    document.querySelectorAll('.tarjeta-plaga').forEach((t) => observador.observe(t));
  } else {
    // Ratón: el foco de luz sigue al cursor dentro de cada tarjeta
    document.querySelectorAll<HTMLElement>('.tarjeta-plaga').forEach((t) =>
      t.addEventListener(
        'pointermove',
        (e) => {
          const r = t.getBoundingClientRect();
          t.style.setProperty('--mx', `${e.clientX - r.left}px`);
          t.style.setProperty('--my', `${e.clientY - r.top}px`);
        },
        { passive: true },
      ),
    );
  }
</script>
