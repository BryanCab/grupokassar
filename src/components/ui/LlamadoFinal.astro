---
import { sucursales, telHref, enlace } from '../../data/sitio';

interface Props {
  titulo?: string;
}
const { titulo = '¿Tienes un problema de plagas? Lo revisamos contigo.' } = Astro.props;
---

<section class="bg-oro text-tinta">
  <div class="contenedor flex flex-col items-start justify-between gap-8 py-16 lg:flex-row lg:items-center">
    <div data-aparece>
      <h2 class="max-w-2xl text-3xl lg:text-5xl">{titulo}</h2>
      <p class="mt-3">Atención las 24 horas, los 365 días del año.</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row" data-aparece>
      <a href={enlace('/contacto/')} class="btn btn-tinta">Solicitar cotización</a>
      <a href={telHref(sucursales[0].telefonos[0])} class="btn border border-tinta hover:bg-tinta hover:text-white">Llamar: {sucursales[0].telefonos[0]}</a>
    </div>
  </div>
</section>
