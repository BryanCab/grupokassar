---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { clientes, respaldo } from '../../data/sitio';
import { logoCliente } from '../../data/fotos';
---

<section class="seccion diferida bg-hueso">
  <div class="contenedor">
    <div data-aparece>
      <p class="kicker text-oro-oscuro">Por qué elegirnos</p>
      <h2 class="titulo mt-3 max-w-3xl">Un servicio con respaldo real.</h2>
    </div>
    <ul class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        respaldo.map((r) => (
          <li data-aparece>
            <Icon name={r.icono} class="size-8 text-oro-oscuro" />
            <h3 class="mt-3 text-lg">{r.titulo}</h3>
            <p class="mt-2 text-sm text-tinta/70">{r.texto}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-20" data-aparece>
      <h3 class="kicker text-tinta/60">Empresas que confían en nosotros</h3>
      <ul class="mt-6 grid grid-cols-2 gap-px bg-tinta/10 sm:grid-cols-4">
        {
          clientes.map((c) => (
            <li class="flex h-32 items-center justify-center bg-white p-3">
              <Image src={logoCliente(c.archivo)} alt={c.nombre} class="max-h-full max-w-full object-contain" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
