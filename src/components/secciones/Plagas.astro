---
import { enlace } from '../../data/sitio';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { categorias, plagas } from '../../data/plagas';
import { fotoDe } from '../../data/fotos';
---

<section class="seccion diferida bg-papel">
  <div class="contenedor">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-aparece>
      <div>
        <p class="kicker text-oro-oscuro">Identifica tu plaga</p>
        <h2 class="titulo mt-3 max-w-2xl">¿Qué estás viendo en tu espacio?</h2>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tipo de plaga">
        <button type="button" data-filtro="todas" aria-pressed="true" class="filtro">Todas</button>
        {Object.entries(categorias).map(([id, nombre]) => <button type="button" data-filtro={id} aria-pressed="false" class="filtro">{nombre}</button>)}
      </div>
    </div>

    <ul class="galeria mt-12 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 lg:gap-4">
      {
        plagas.map((p, i) => {
          const foto = fotoDe(p.foto);
          return (
            <li data-categoria={p.categoria} data-aparece>
              <a href={enlace(`/control-de-plagas/${p.slug}/`)} class="tarjeta-plaga group relative block aspect-square overflow-hidden rounded-sm bg-tinta text-white" aria-label={`${p.nombre}: ${p.resumen}`}>
                {foto ? (
                  <Image src={foto} alt="" widths={[320, 480, 640]} quality={62} sizes="(min-width: 1024px) 25vw, 50vw" class="foto-plaga absolute inset-0 size-full object-cover" />
                ) : (
                  <Icon name={p.icono} class="absolute top-1/2 left-1/2 size-24 -translate-x-1/2 -translate-y-1/2 text-linea" />
                )}
                <span class="velo absolute inset-0" aria-hidden="true"></span>

                <span class="marco" aria-hidden="true">
                  <i class="esq esq-1"></i><i class="esq esq-2"></i><i class="esq esq-3"></i><i class="esq esq-4"></i>
                </span>

                <span class="numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="flecha" aria-hidden="true"><Icon name="ph:arrow-up-right-bold" class="size-4" /></span>

                <span class="texto absolute inset-x-0 bottom-0 p-4 lg:p-5">
                  <span class="etiqueta">{categorias[p.categoria]}</span>
                  <span class="nombre">{p.nombre}</span>
                  <span class="barra" aria-hidden="true"></span>
                  <span class="resumen">{p.resumen}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .filtro {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid color-mix(in srgb, var(--color-tinta) 25%, transparent);
    border-radius: 2px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .filtro:hover {
    border-color: var(--color-oro-oscuro);
  }
  .filtro[aria-pressed='true'] {
    background: var(--color-tinta);
    color: #fff;
    border-color: var(--color-tinta);
  }

  /* Tarjeta con marco: reposo, hover/foco y "activa" (pantallas táctiles, al cruzar el centro) */
  .tarjeta-plaga {
    isolation: isolate;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-tinta) 40%, transparent);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease;
  }
  .tarjeta-plaga:hover,
  .tarjeta-plaga:focus-visible,
  .tarjeta-plaga.activa {
    box-shadow:
      0 0 0 1px var(--color-oro),
      0 22px 44px -20px rgb(0 0 0 / 0.6);
  }
  .tarjeta-plaga:active {
    transform: scale(0.97);
  }

  .velo {
    background:
      linear-gradient(to top, var(--color-tinta) 4%, color-mix(in srgb, var(--color-tinta) 55%, transparent) 38%, transparent 70%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-tinta) 55%, transparent), transparent 28%);
  }

  .marco {
    position: absolute;
    inset: 10px;
    z-index: 1;
    pointer-events: none;
    border: 1px solid rgb(255 255 255 / 0.18);
    transition:
      inset 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.35s ease;
  }
  .tarjeta-plaga:hover .marco,
  .tarjeta-plaga:focus-visible .marco,
  .tarjeta-plaga.activa .marco {
    inset: 14px;
    border-color: color-mix(in srgb, var(--color-oro) 55%, transparent);
  }
  .esq {
    position: absolute;
    width: 16px;
    height: 16px;
    opacity: 0;
    border: 0 solid var(--color-oro);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .esq-1 { top: -2px; left: -2px; border-top-width: 3px; border-left-width: 3px; transform: translate(6px, 6px); }
  .esq-2 { top: -2px; right: -2px; border-top-width: 3px; border-right-width: 3px; transform: translate(-6px, 6px); }
  .esq-3 { bottom: -2px; left: -2px; border-bottom-width: 3px; border-left-width: 3px; transform: translate(6px, -6px); }
  .esq-4 { bottom: -2px; right: -2px; border-bottom-width: 3px; border-right-width: 3px; transform: translate(-6px, -6px); }
  .tarjeta-plaga:hover .esq,
  .tarjeta-plaga:focus-visible .esq,
  .tarjeta-plaga.activa .esq {
    opacity: 1;
    transform: none;
  }

  .numero {
    position: absolute;
    top: 1.3rem;
    left: 1.4rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-oro);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }
  .flecha {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: var(--color-oro);
    color: var(--color-tinta);
    opacity: 0;
    transform: scale(0.5) rotate(-45deg);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }
  .tarjeta-plaga:hover .flecha,
  .tarjeta-plaga:focus-visible .flecha,
  .tarjeta-plaga.activa .flecha {
    opacity: 1;
    transform: none;
  }

  .texto {
    z-index: 2;
    display: block;
  }
  .etiqueta {
    display: block;
    font-family: var(--font-display);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--color-oro);
  }
  .nombre {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.1;
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.55);
  }
  .barra {
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 0.6rem;
    background: var(--color-oro);
    transform-origin: left;
    transform: scaleX(0.3);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tarjeta-plaga:hover .barra,
  .tarjeta-plaga:focus-visible .barra,
  .tarjeta-plaga.activa .barra {
    transform: scaleX(1.6);
  }
  .resumen {
    display: none;
    max-height: 0;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.85);
    opacity: 0;
    transition:
      max-height 0.45s ease,
      opacity 0.35s ease,
      margin 0.45s ease;
  }
  @media (min-width: 640px) {
    .resumen {
      display: block;
    }
    .tarjeta-plaga:hover .resumen,
    .tarjeta-plaga:focus-visible .resumen,
    .tarjeta-plaga.activa .resumen {
      max-height: 5rem;
      margin-top: 0.55rem;
      opacity: 1;
    }
  }
  @media (min-width: 640px) {
    .etiqueta {
      font-size: 0.625rem;
      letter-spacing: 0.2em;
    }
  }
  @media (min-width: 1024px) {
    .nombre {
      font-size: 1.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marco,
    .esq,
    .flecha,
    .barra,
    .resumen,
    .tarjeta-plaga {
      transition: none;
    }
  }
</style>

<script>
  // En pantallas táctiles no existe el hover: las tarjetas que cruzan el centro de la pantalla toman color
  if (matchMedia('(hover: none)').matches) {
    const observador = new IntersectionObserver(
      (entradas) => entradas.forEach((e) => e.target.classList.toggle('activa', e.isIntersecting)),
      { rootMargin: '-30% 0px -30% 0px' },
    );
    document.querySelectorAll('.tarjeta-plaga').forEach((t) => observador.observe(t));
  }

  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-categoria]');
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const filtro = b.dataset.filtro;
      botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      tarjetas.forEach((t) => {
        t.hidden = filtro !== 'todas' && t.dataset.categoria !== filtro;
        t.style.opacity = '1';
        t.style.transform = 'none';
      });
    }),
  );
</script>
