---
import { categorias, plagas } from '../../data/plagas';
import TarjetaPlaga from '../ui/TarjetaPlaga.astro';

// Mosaico: en escritorio 4 columnas × 5 filas (20 celdas) y en móvil 2 columnas con 4 tarjetas anchas.
// La posición sale del orden de `plagas`; si se filtra, todas pasan a celdas iguales.
const patron: { tam: 'std' | 'wide' | 'tall' | 'xl'; movil?: 'ancha' }[] = [
  { tam: 'xl', movil: 'ancha' },
  { tam: 'std' },
  { tam: 'std' },
  { tam: 'wide', movil: 'ancha' },
  { tam: 'std' },
  { tam: 'tall' },
  { tam: 'wide', movil: 'ancha' },
  { tam: 'std' },
  { tam: 'wide' },
  { tam: 'wide', movil: 'ancha' },
  { tam: 'std' },
  { tam: 'std' },
];
const total = plagas.length;
---

<section class="seccion diferida bg-papel">
  <div class="contenedor">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-aparece>
      <div>
        <p class="kicker text-oro-oscuro">Identifica tu plaga</p>
        <h2 class="titulo mt-3 max-w-2xl">¿Qué estás viendo en tu espacio?</h2>
        <p class="mt-4 text-tinta/60"><span class="font-display font-bold text-tinta" data-contador>{total}</span> servicios especializados. Toca o pasa el cursor sobre cada uno.</p>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tipo de plaga">
        <button type="button" data-filtro="todas" aria-pressed="true" class="filtro">Todas</button>
        {Object.entries(categorias).map(([id, nombre]) => <button type="button" data-filtro={id} aria-pressed="false" class="filtro">{nombre}</button>)}
      </div>
    </div>

    <div class="caja mt-12">
      <ul class="galeria">
        {
          plagas.map((p, i) => {
            const celda = patron[i] ?? { tam: 'std' as const };
            return (
              <li data-categoria={p.categoria} data-tam={celda.tam} data-movil={celda.movil} data-aparece>
                <TarjetaPlaga plaga={p} tam={celda.tam} sizes={celda.tam === 'xl' || celda.tam === 'wide' ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'} />
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .filtro {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid color-mix(in srgb, var(--color-tinta) 25%, transparent);
    border-radius: 2px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .filtro:hover {
    border-color: var(--color-oro-oscuro);
  }
  .filtro[aria-pressed='true'] {
    background: var(--color-tinta);
    color: #fff;
    border-color: var(--color-tinta);
  }

  /* La caja es el contenedor de consulta: sus unidades cqw dan el alto de cada fila (celdas cuadradas) */
  .caja {
    container-type: inline-size;
  }
  .galeria {
    --hueco: 0.75rem;
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: calc((100cqw - var(--hueco)) / 2);
    gap: var(--hueco);
  }
  .galeria > li {
    min-height: 0;
  }
  .galeria > li[data-movil='ancha'] {
    grid-column: span 2;
  }
  @media (min-width: 640px) {
    .galeria {
      --hueco: 1rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: calc((100cqw - 3 * var(--hueco)) / 4);
    }
    .galeria > li[data-movil='ancha'] {
      grid-column: auto;
    }
    .galeria > li[data-tam='xl'] {
      grid-column: span 2;
      grid-row: span 2;
    }
    .galeria > li[data-tam='wide'] {
      grid-column: span 2;
    }
    .galeria > li[data-tam='tall'] {
      grid-row: span 2;
    }
    /* Con un filtro activo quedan menos tarjetas: todas del mismo tamaño para no dejar huecos */
    .galeria.filtrada > li {
      grid-column: auto;
      grid-row: auto;
    }
  }
  .galeria.filtrada > li[data-movil='ancha'] {
    grid-column: auto;
  }
</style>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-categoria]');
  const galeria = document.querySelector('.galeria');
  const contador = document.querySelector('[data-contador]');
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const filtro = b.dataset.filtro;
      botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      galeria?.classList.toggle('filtrada', filtro !== 'todas');
      let visibles = 0;
      tarjetas.forEach((t) => {
        t.hidden = filtro !== 'todas' && t.dataset.categoria !== filtro;
        if (!t.hidden) visibles++;
        t.style.opacity = '1';
        t.style.transform = 'none';
      });
      if (contador) contador.textContent = String(visibles);
    }),
  );
</script>
