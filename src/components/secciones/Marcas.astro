---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { enlace } from '../../data/sitio';
import fondoPlagas from '../../assets/marca/fondo-control-total.jpg';
import fondoLavado from '../../assets/marca/fondo-good-washed.jpg';

const marcas = [
  {
    clase: 'marca-plagas',
    posicion: '72% 30%',
    href: '/control-de-plagas/',
    foto: fondoPlagas,
    nombre: 'Kassar Control Total',
    titulo: 'Exterminio y control de plagas urbanas',
    texto: 'Insectos rastreros, roedores, termitas, chinches y manejo responsable de fauna nociva.',
    chips: ['Cucarachas', 'Roedores', 'Termitas', 'Chinches'],
    icono: 'ph:bug-beetle',
    acento: 'text-oro',
    boton: 'bg-oro',
  },
  {
    clase: 'marca-lavado',
    posicion: '55% 50%',
    href: '/control-de-patogenos/',
    foto: fondoLavado,
    nombre: 'Kassar Good Washed',
    titulo: 'Control de patógenos y sanitización',
    texto: 'Entornos más limpios y seguros, con lavado y desinfección de textiles.',
    chips: ['Lavado de textiles', 'Desinfección', 'Sanitización'],
    icono: 'ph:drop',
    acento: 'text-azul-claro',
    boton: 'bg-azul-claro',
  },
];
---

<section class="grid bg-tinta text-white lg:grid-cols-2">
  {
    marcas.map((m, i) => (
      <a href={enlace(m.href)} class:list={['marca group relative isolate flex min-h-[30rem] flex-col justify-between overflow-hidden p-6 sm:p-10 lg:min-h-[40rem] lg:p-14', m.clase]}>
        <Image src={m.foto} alt="" widths={[640, 960, 1280]} quality={60} sizes="(min-width: 1024px) 50vw, 100vw" class="marca-foto absolute inset-0 -z-20 size-full object-cover" style={`object-position: ${m.posicion}`} />
        <span class="marca-color absolute inset-0 -z-10" aria-hidden="true"></span>
        <span class="marca-degradado absolute inset-0 -z-10" aria-hidden="true"></span>
        <span class="marca-brillo absolute inset-0 -z-10" aria-hidden="true"></span>

        <div class="flex items-start justify-between" data-aparece>
          <span class:list={['font-display text-sm font-bold tracking-[0.25em]', m.acento]}>
            0{i + 1}<span class="mx-2 text-white/40">/</span><span class="text-white/60">02</span>
          </span>
          <span class:list={['marca-icono grid size-14 place-items-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm', m.acento]}>
            <Icon name={m.icono} class="size-7" />
          </span>
        </div>

        <div data-aparece>
          <p class:list={['kicker', m.acento]}>{m.nombre}</p>
          <h2 class="mt-3 max-w-xl text-4xl lg:text-6xl">{m.titulo}</h2>
          <p class="mt-4 max-w-md text-white/85 lg:text-lg">{m.texto}</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {m.chips.map((c) => <li class="rounded-full border border-white/30 bg-white/10 px-3.5 py-1.5 text-xs font-medium backdrop-blur-sm">{c}</li>)}
          </ul>
          <span class:list={['mt-8 inline-flex items-center gap-3 rounded-sm px-6 py-3.5 font-display text-sm font-bold text-tinta transition-[gap] duration-300 group-hover:gap-5', m.boton]}>
            Conocer servicios <Icon name="ph:arrow-right-bold" class="size-4" />
          </span>
        </div>
      </a>
    ))
  }
</section>

<style>
  /* Foto en blanco y negro que se tiñe del color de la marca; al pasar el cursor recupera color */
  .marca-foto {
    filter: grayscale(1) contrast(1.1) brightness(0.95);
    transform: scale(1.04);
    transition:
      transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.9s ease;
  }
  .marca:hover .marca-foto,
  .marca:focus-visible .marca-foto {
    transform: scale(1.12);
    filter: grayscale(0.15) contrast(1.05) brightness(1);
  }
  .marca-color {
    mix-blend-mode: multiply;
    opacity: 0.92;
    transition: opacity 0.9s ease;
  }
  .marca:hover .marca-color,
  .marca:focus-visible .marca-color {
    opacity: 0.55;
  }
  .marca-plagas .marca-color {
    background: linear-gradient(135deg, #f0a040 0%, #b9651f 100%);
  }
  .marca-lavado .marca-color {
    background: linear-gradient(135deg, #2f9fe0 0%, #0f5583 100%);
  }
  .marca-degradado {
    background:
      linear-gradient(to top, var(--fondo) 4%, color-mix(in srgb, var(--fondo) 62%, transparent) 36%, transparent 72%),
      linear-gradient(to bottom, color-mix(in srgb, var(--fondo) 45%, transparent), transparent 26%);
  }
  .marca-plagas {
    --fondo: #1d1008;
  }
  .marca-lavado {
    --fondo: #03192b;
  }
  /* Destello diagonal al pasar el cursor */
  .marca-brillo {
    background: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / 0.2) 50%, transparent 62%);
    transform: translateX(-120%);
    transition: transform 1.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .marca:hover .marca-brillo {
    transform: translateX(120%);
  }
  .marca-icono {
    transition:
      transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3),
      background-color 0.3s;
  }
  .marca:hover .marca-icono {
    transform: rotate(-12deg) scale(1.1);
    background-color: rgb(255 255 255 / 0.2);
  }
  /* Línea fina entre las dos marcas en escritorio */
  @media (min-width: 1024px) {
    .marca + .marca {
      box-shadow: inset 1px 0 0 rgb(255 255 255 / 0.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marca-foto,
    .marca-color,
    .marca-brillo,
    .marca-icono {
      transition: none;
    }
  }
</style>
